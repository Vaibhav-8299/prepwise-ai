{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=PREPWISE;User=root;Password=YOUR_MYSQL_PASSWORD;"
  },
  "JwtSettings": {
    "SecretKey": "YOUR_JWT_SECRET_KEY_MUST_BE_AT_LEAST_32_CHARS_LONG",
    "Issuer": "PrepWiseAPI",
    "Audience": "PrepWiseClient",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "EmailSettings": {
    "SmtpServer": "smtp.gmail.com",
    "SmtpPort": 587,
    "SenderEmail": "YOUR_GMAIL@gmail.com",
    "SenderPassword": "YOUR_GMAIL_APP_PASSWORD",
    "SenderName": "PrepWise AI"
  },
  "GeminiSettings": {
    "ApiKey": "YOUR_GEMINI_API_KEY",
    "Model": "gemini-2.0-flash"
  }
}